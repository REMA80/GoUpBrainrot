# Kopiere diese Datei zu ".env" und trage deine Keys ein.
# Die Datei .env wird NICHT zu GitHub hochgeladen (steht in .gitignore).

# --- Pflicht ---------------------------------------------------------
# Spracherkennung: groq (Gratis-Kontingent) oder openai (kostenpflichtig)
STT_PROVIDER=groq
# Groq (console.groq.com -> API Keys), beginnt mit gsk_
GROQ_API_KEY=
# Nur noetig, wenn STT_PROVIDER=openai (platform.openai.com -> API keys), beginnt mit sk-
OPENAI_API_KEY=
# DeepL API Free (deepl.com -> Account -> API Keys), endet auf :fx
DEEPL_API_KEY=

# --- Optional --------------------------------------------------------
# In welche Sprache uebersetzt wird (DE, EN, FR, ES, IT, PL, TR, ...).
# Die Sprache der Mitspieler wird automatisch erkannt.
TARGET_LANG=DE

# loopback = alles, was aus deinen Lautsprechern/Kopfhoerern kommt
# mic      = dein Mikrofon
AUDIO_SOURCE=loopback

# Leer = Windows-Standardgeraet. Sonst ein Teil des Geraetenamens
# (Liste mit: python translator.py --geraete)
AUDIO_DEVICE=

# Uebersetzung vorlesen? 1 = ja, 0 = nur Text
SPEAK=1
# Sprechtempo der Windows-Stimme, -10 (langsam) bis 10 (schnell)
TTS_RATE=1

# Ab welcher Lautstaerke gilt etwas als Sprache (einstellen mit --pegel)
VOLUME_THRESHOLD=0.01
# So lange Stille beendet einen Satz (Sekunden)
SILENCE_SECONDS=0.8
# Kuerzere Geraeusche werden ignoriert (Sekunden)
MIN_SPEECH_SECONDS=0.5
# Laengere Saetze werden spaetestens hier abgeschnitten (Sekunden)
MAX_SPEECH_SECONDS=15

# Modell fuer Speech-to-Text. Leer = Standard des Anbieters
# (Groq: whisper-large-v3-turbo, OpenAI: whisper-1)
STT_MODEL=

# Handy als zweiter Bildschirm: 1 = an, 0 = aus.
# Beim Start zeigt das Programm eine Adresse wie http://192.168.x.x:8765
# - die im Handy-Browser oeffnen (gleiches WLAN).
PHONE_VIEW=1
PHONE_PORT=8765

# --- Gegenrichtung: deine Stimme -> Mitspieler (braucht VB-Cable) ---
# Mitspieler -> ich (1 = an) und ich -> Mitspieler (1 = an)
IN_ENABLED=1
OUT_ENABLED=0
# Dein echtes Mikrofon (leer = Windows-Standard)
OUT_MIC_DEVICE=
# Zielsprache fuer deine Stimme. AUTO = Sprache, die die Mitspieler zuletzt sprachen
OUT_TARGET_LANG=AUTO
# Wohin die Ansage geht (Teil des Geraetenamens)
OUT_OUTPUT_DEVICE=CABLE Input
OUT_VOLUME_THRESHOLD=0.02
